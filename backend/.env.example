# Copy to backend/.env and fill in. backend/.env is gitignored; never commit real keys.

# Supabase (checked at startup by backend/src/backend/settings.py)
# The project URL, like https://<ref>.supabase.co, not the one ending in /rest/v1.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only: bypasses row-level security. Never put it in the frontend.
SUPABASE_SECRET_KEY=

# AI bill extraction (DC-52). Server-side only; tests remove these for the test run.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
