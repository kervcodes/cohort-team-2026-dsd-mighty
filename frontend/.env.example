# Copy to .env.local and fill in. Values below are for local development.
# `npx supabase status` (run from backend/) prints the local URL and anon key.
# Only public values belong here: never put the Supabase secret (service role) key in the frontend.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# The FastAPI backend (backend/: uv run uvicorn backend.app:app --reload)
NEXT_PUBLIC_API_URL=http://localhost:8000
