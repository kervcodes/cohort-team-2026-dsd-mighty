# Fix staged files and re-stage them. Skip in an emergency: git commit --no-verify
if [ ! -x frontend/node_modules/.bin/lint-staged ]; then
  # Backend-only setup (no frontend install): run Ruff on staged Python files ourselves.
  if git diff --cached --quiet --diff-filter=ACMR -- 'backend/*.py'; then
    git diff --cached --quiet --diff-filter=ACMR -- 'frontend/' ||
      echo "pre-commit: frontend files not checked; run 'pnpm install' in frontend/ to enable Biome"
    exit 0
  fi
  if ! command -v uv >/dev/null 2>&1; then
    echo "pre-commit: uv not found, skipping Ruff for backend files (CI will still check them)"
    exit 0
  fi
  # Files with unstaged edits are only checked, never rewritten, so WIP hunks are not committed.
  git diff --cached -z --name-only --diff-filter=ACMR -- 'backend/*.py' | xargs -0 sh -c '
    rc=0
    for f; do
      if git diff --quiet -- "$f"; then
        uv run --project backend ruff check --fix "$f" && uv run --project backend ruff format "$f" && git add -- "$f" || rc=1
      else
        echo "pre-commit: $f has unstaged changes; checking only (not auto-fixing)"
        uv run --project backend ruff check "$f" && uv run --project backend ruff format --check "$f" || rc=1
      fi
    done
    exit $rc' _
  exit $?
fi
DS_ALIAS_ROOT=app DS_UI_DIR=app/components/ui frontend/node_modules/.bin/lint-staged --config lint-staged.config.mjs || exit 1

# --- Lock file guard ---
# Rejects lock files from the wrong package manager. This project uses pnpm.
WRONG_LOCKS="frontend/package-lock.json frontend/yarn.lock frontend/bun.lockb"
STAGED=$(git diff --cached --name-only)
for lockfile in $WRONG_LOCKS; do
  if echo "$STAGED" | grep -qx "$lockfile"; then
    echo "error: $lockfile was staged but this project uses pnpm."
    echo "  Run: git rm --cached $lockfile"
    echo "  (You may also want to add it to .gitignore)"
    exit 1
  fi
done

# --- Next.js 16 convention guard ---
# Next.js 16 deprecated middleware.ts in favor of proxy.ts.
# Only runs if the project uses Next.js 16+.
if [ -f "frontend/package.json" ]; then
  NEXT_VERSION=$(node -e "try{const p=require('./frontend/package.json');const v=(p.dependencies||{}).next||(p.devDependencies||{}).next||'';const m=v.match(/(\d+)/);if(m)process.stdout.write(m[1])}catch(e){}" 2>/dev/null)
  if [ -n "$NEXT_VERSION" ] && [ "$NEXT_VERSION" -ge 16 ] 2>/dev/null; then
    STAGED_FILES=$(git diff --cached --name-only)
    DELETED_FILES=$(git diff --cached --name-only --diff-filter=D)

    # Block staging middleware.ts
    if echo "$STAGED_FILES" | grep -qE '(^|/)middleware\.(ts|js)$'; then
      echo "error: middleware.ts is deprecated in Next.js 16+. Use proxy.ts instead."
      echo "  See: https://nextjs.org/docs/app/api-reference/file-conventions/proxy"
      exit 1
    fi

    # Block deleting proxy.ts
    if echo "$DELETED_FILES" | grep -qE '(^|/)proxy\.(ts|js)$'; then
      echo "error: proxy.ts is required for Next.js 16+ (replaces middleware.ts)."
      echo "  Do not delete this file."
      exit 1
    fi
  fi
fi

# --- Large file guard (warning only) ---
# Flags staged files over 250 lines to encourage decomposition.
# Allowlist: .husky/large-files-allowlist.txt (one glob per line)
LARGE_FILE_LIMIT=250
ALLOWLIST=".husky/large-files-allowlist.txt"

for file in $(git diff --cached --name-only --diff-filter=ACM); do
  # Skip auto-exempt patterns: tests, deprecated, docs, config formats
  case "$file" in
    *.test.*|*.spec.*|*.stories.*) continue ;;
    *deprecated*|*DEPRECATED*) continue ;;
    *.md|*.mdx|*.toml|*.json|*.yaml|*.yml) continue ;;
  esac

  # Skip files in allowlist
  if [ -f "$ALLOWLIST" ]; then
    skip=false
    while IFS= read -r pattern; do
      case "$pattern" in \#*|"") continue ;; esac
      case "$file" in $pattern) skip=true; break ;; esac
    done < "$ALLOWLIST"
    [ "$skip" = true ] && continue
  fi

  # Count lines (only for text files that exist)
  [ -f "$file" ] || continue
  lines=$(wc -l < "$file" | tr -d ' ')
  if [ "$lines" -gt "$LARGE_FILE_LIMIT" ]; then
    echo "warning: $file has $lines lines (limit: $LARGE_FILE_LIMIT). Consider decomposing."
  fi
done

# --- Secret scanning (gitleaks) ---
# Scans staged changes for secrets. Graceful degradation if not installed.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --verbose
  if [ $? -ne 0 ]; then
    echo ""
    echo "error: gitleaks detected secrets in staged changes."
    echo "  Remove the secrets before committing."
    echo "  Bypass (rare): git commit --no-verify"
    exit 1
  fi
else
  echo "warning: gitleaks not installed. Skipping secret scan. (brew install gitleaks)"
fi
